# Optional GitHub token for higher API limits.
# GITHUB_TOKEN=ghp_replace_me

# Knowledge output root. Defaults to:
# $HOME/.codex/memories/work_contexts/github_engineering_patterns
# KNOWLEDGE_ROOT=/absolute/path/to/knowledge-root
# WORK_CONTEXTS_ROOT=/absolute/path/to/work_contexts

# Extraction mode: auto, heuristic, or llm.
# EXTRACTOR_MODE=auto

# Optional OpenAI configuration for LLM extraction and review.
# OPENAI_API_KEY=sk_replace_me
# OPENAI_MODEL=gpt-5.5
# OPENAI_REASONING_EFFORT=medium
# LLM_REVIEW=1
